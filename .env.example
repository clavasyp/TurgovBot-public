# =============================================================================
# TurgovBot — Шаблон переменных окружения
# Скопируйте этот файл: cp .env.example .env
# И заполните значениями
# =============================================================================

# --- База данных PostgreSQL ---
DB_USER=bot_db_user
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432
DB_NAME=bot_database

# --- Telegram ---
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# --- Google Cloud Platform ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=global
GCS_BUCKET_NAME=your-gcs-bucket
VERTEX_CREDENTIALS_FILE=turgovbotv3-b1dbe05a84fe.json
GOOGLE_CREDENTIALS_FILE=credentials.json
SPEECH_TO_TEXT_CREDENTIALS_FILE=majestic-rp-bot-0ccbaf125d81.json

# --- Google Sheets ---
SPREADSHEET_ID=YOUR_SPREADSHEET_ID

# --- Прокси ---
IMGUR_SOCKS5_PROXY=host:port:username:password
FORUM_HTTP_PROXY=host:port:username:password

# --- Удалённый парсер ---
PARSER_WORKER_URL=http://parser-worker:8765
PARSER_SECRET_KEY=CHANGE_ME_RANDOM_SECRET

# --- Учётные записи форумов (разделы закрыты за авторизацией) ---
# Без них parser-worker увидит login-wall → 0 ссылок → сработает защита БЗ, а судебка
# и разбор жалоб на этих форумах вернут пустой результат.
FORUM_MAJESTIC_LOGIN=YOUR_MAJESTIC_LOGIN
FORUM_MAJESTIC_PASSWORD=YOUR_MAJESTIC_PASSWORD
FORUM_RUSSIA_ONLINE_LOGIN=YOUR_RUSSIA_ONLINE_LOGIN
FORUM_RUSSIA_ONLINE_PASSWORD=YOUR_RUSSIA_ONLINE_PASSWORD

# --- API Сервер ---
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8000

# --- Секреты подписи (длинные случайные строки, например: openssl rand -hex 32) ---
# Без DEVICE_JWT_SECRET токены устройств подписываются случайным ключом процесса
# и не переживают рестарт, а веб-вход сайта выключен.
DEVICE_JWT_SECRET=
# Необязательно: отдельные секреты; по умолчанию берутся из DEVICE_JWT_SECRET.
WEB_SESSION_SECRET=
INTERNAL_API_SECRET=
KILL_SWITCH_INTERNAL_SECRET=

# --- Релей для пользователей из РФ (необязательно) ---
# IP релей-серверов через запятую (IPv4/IPv6). Вся когорта за релеем видна как один IP,
# поэтому лимит запросов для этих адресов умножается на OVERLAY_RELAY_RPM_MULT.
OVERLAY_RELAY_IPS=
OVERLAY_RELAY_RPM_MULT=10

# --- Локальный FRIDA-поиск законов ---
# Включать только когда pinned-модель разложена в ./models/frida на Docker-хосте.
# API использует её для query-вектора; dedicated worker достраивает корпус статей.
LAW_CATALOG_EMBED_ENABLED=false
LAW_CATALOG_EMBED_MODEL_DIR=/app/models/frida
# В compose значения для API/worker заданы раздельно. Этот default не даёт
# случайному API-процессу запустить второй consumer той же durable-очереди.
LAW_EMBED_RUN_WORKER=false
LAW_EMBED_WORKER_INTRA_THREADS=6
LAW_EMBED_WORKER_INFERENCE_CHUNK_SIZE=4
LAW_EMBED_WORKER_INIT_TIMEOUT_SECONDS=120
LAW_EMBED_JOB_CHUNK_TIMEOUT_SECONDS=120
LAW_EMBED_WORKER_HEARTBEAT_SECONDS=5
LAW_EMBED_WORKER_HEALTH_MAX_AGE_SECONDS=45
LAW_SEARCH_EMBED_TIMEOUT=2.0

# Журнал качества поиска: вопрос + компактный снимок реально показанной выдачи.
# Запись идёт через bounded-очередь и никогда не блокирует пользовательский запрос.
LAW_SEARCH_LOG_ENABLED=true
LAW_SEARCH_LOG_RETENTION_DAYS=90
LAW_SEARCH_LOG_QUEUE_SIZE=2048
LAW_SEARCH_LOG_BATCH_SIZE=50
LAW_SEARCH_LOG_FLUSH_SECONDS=1.0
LAW_SEARCH_LOG_DB_TIMEOUT=2.0
LAW_SEARCH_LOG_SHUTDOWN_TIMEOUT=3.0

# --- Администрирование ---
SUPER_ADMIN_ID=YOUR_TELEGRAM_USER_ID
